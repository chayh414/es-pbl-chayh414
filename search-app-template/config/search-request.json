{
  "_source": [
    "item_id",
    "item_name",
    "description",
    "category",
    "brand",
    "price",
    "condition",
    "seller_rating"
  ],
  "query": {
    "multi_match": {
      "query": "{{searchText}}",
      "fields": ["item_name^3", "description"]
    }
  },
  "highlight": {
    "pre_tags": ["<mark>"],
    "post_tags": ["</mark>"],
    "fields": {
      "item_name": {},
      "description": {}
    }
  },
  "sort": [
    { "_score": "desc" },
    { "seller_rating": "desc" }
  ]
}
